PORT=3000
HOST=127.0.0.1

# VIP 解灰：fee=1 时自动从 QQ/酷狗/酷我/咪咕 多音源匹配
ENABLE_GENERAL_UNBLOCK=true

# FLAC 无损
ENABLE_FLAC=true

# 随机中国 IP（绕风控）
ENABLE_RANDOM_CN_IP=true

# CORS：允许所有来源（OBS Browser Source 需要）
CORS_ALLOW_ORIGIN=*

# 关键：并发所有音源，选码率最高的（酷狗 320k > 酷我 128k 片段）
# 不设的话默认 Promise.any 谁先返回用谁（酷我快但只有片段）
SELECT_MAX_BR=true
